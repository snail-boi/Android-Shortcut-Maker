<Window x:Class="android_shortcut_maker.HotkeyPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Press a key"
        Width="320" Height="160"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock Text="Press any key or key combination."
                   Foreground="{DynamicResource SubtleTextBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                CornerRadius="6" Padding="10,6" Margin="0,0,0,14">
            <TextBlock x:Name="TxtKey" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Text="Waiting..." HorizontalAlignment="Center"/>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="80" Margin="0,0,8,0" Content="Clear"  Click="BtnClear_Click"/>
            <Button Width="80" Margin="0,0,8,0" Content="Cancel" Click="BtnCancel_Click"/>
            <Button x:Name="BtnOk" Width="80" Content="OK" IsDefault="True"
                    Click="BtnOk_Click" IsEnabled="False"/>
        </StackPanel>
    </StackPanel>
</Window>
