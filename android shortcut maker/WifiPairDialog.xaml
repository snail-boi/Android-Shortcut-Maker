<Window x:Class="android_shortcut_maker.WifiPairDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair Wireless Debugging"
        Width="460" Height="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <StackPanel>
            <TextBlock FontWeight="Bold" FontSize="14" Margin="0,0,0,8"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Text="Pair this PC with your phone"/>

            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"
                       Foreground="{DynamicResource SubtleTextBrush}">
                On your phone open <Run FontWeight="SemiBold">Developer options</Run>,
                tap <Run FontWeight="SemiBold">Wireless debugging</Run>, then
                <Run FontWeight="SemiBold">Pair device with pairing code</Run>.
                Enter the IP and port shown on that screen (top line) and the
                6-digit code below.
            </TextBlock>

            <TextBlock Text="Pairing address (ip:port):" Margin="0,0,0,4"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBox x:Name="TxtPairAddress" Margin="0,0,0,12"/>

            <TextBlock Text="Pairing code (6 digits):" Margin="0,0,0,4"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBox x:Name="TxtPairCode" Margin="0,0,0,12" MaxLength="10"/>

            <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" FontSize="12"
                       Foreground="OrangeRed" Margin="0,0,0,8" Text=""/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Width="80" Margin="0,0,8,0" Content="Cancel" Click="BtnCancel_Click"/>
                <Button x:Name="BtnPair" Width="80" Content="Pair"
                        Click="BtnPair_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
